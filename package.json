{
  "name": "abmeta",
  "version": "0.1.0",
  "description": "A TypeScript CLI tool that scans an input directory, resolves audiobook metadata via multiple book APIs, writes ID3/M4B tags, downloads cover art, and restructures files into an Audiobookshelf-compatible layout.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "abmeta": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "cheerio": "1.2.0",
    "commander": "12.1.0",
    "ffprobe-static": "3.1.0",
    "glob": "11.1.0",
    "js-yaml": "4.3.0",
    "node-id3": "0.2.9",
    "picocolors": "1.1.1",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@types/cheerio": "0.22.35",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "9.39.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
